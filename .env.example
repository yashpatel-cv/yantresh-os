# Yantresh — environment template. Copy to .env and `source` it (or use direnv).
# NEVER commit a real key. NEVER paste a key into code, config, chat, or logs —
# if a key has ever appeared in plaintext anywhere, rotate it immediately.

# DeepSeek (model strings "deepseek/..." in yantresh.toml)
DEEPSEEK_API_KEY=

